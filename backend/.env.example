# 环境变量模板（复制为 .env 后填写真实值，.env 不入库）
# 数据库连接（本地 Docker PostgreSQL，端口 5433）
DATABASE_URL=postgresql+asyncpg://competitor:competitor@localhost:5433/competitor

# LLM 配置（OpenAI 兼容接口；留空则自动回退到规则提炼）
LLM_API_BASE=https://www.rightapi.ai/codex/v1
LLM_MODEL=gpt-5.4-mini
LLM_API_KEY=

# LLM 成本熔断（可选，均有默认值）
# 会话累计消费超过该元数即中断并征询用户同意；默认 1.0
# LLM_COST_LIMIT_CNY=1.0
# 单价：每百万 token 美元（gpt-5.4-mini：输入0.75 / 输出4.5）；汇率用于换算人民币预估
# LLM_INPUT_PRICE_USD_PER_MTOK=0.75
# LLM_OUTPUT_PRICE_USD_PER_MTOK=4.5
# USD_CNY_RATE=7.1
