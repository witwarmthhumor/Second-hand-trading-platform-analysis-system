# 环境变量模板（复制为 .env 后填写真实值，.env 不入库）
# 数据库连接（本地 Docker PostgreSQL，端口 5433）
# ⚠️ 数据库连接必须显式配置：代码不再内置默认凭证，缺失将启动报错。
# 此为用户/密码为本地开发库默认凭证，仅绑定 localhost；生产环境必须更换强密码
DATABASE_URL=postgresql+asyncpg://competitor:competitor@localhost:5433/competitor

# Redis（RAG 检索缓存，本地 Docker Redis 端口 6380）
# REDIS_URL=redis://localhost:6380/0
# 检索缓存 TTL（秒），默认 1 小时
# RAG_CACHE_TTL=3600

# 调试模式（默认 False，异常不返回堆栈；本地开发可设为 True）
# DEBUG=False

# LLM 配置（OpenAI 兼容接口；留空则自动回退到规则提炼）
LLM_API_BASE=https://www.rightapi.ai/codex/v1
LLM_MODEL=gpt-5.6-luna
LLM_API_KEY=

# JWT 签名密钥（必填；生产环境必须用随机强密钥，如 `openssl rand -hex 32`）
JWT_SECRET=

# 内置管理员（首次启动自动 seed，仅当用户表为空时创建）
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=123456

# LLM 成本熔断（可选，均有默认值）
# 会话累计消费超过该元数即中断并征询用户同意；默认 1.0
# LLM_COST_LIMIT_CNY=1.0
# 单价：每百万 token 美元。rightapi 网关把 gpt-5.6-luna 路由到 terra，按 terra 价（输入2.0/输出12.0）保守估算
# LLM_INPUT_PRICE_USD_PER_MTOK=2.0
# LLM_OUTPUT_PRICE_USD_PER_MTOK=12.0
# USD_CNY_RATE=7.1
